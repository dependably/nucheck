<?xml version="1.0" encoding="utf-8"?>
<!--
  Restore dependencies from public nuget.org only.

  The clear element drops any inherited package sources (e.g. a machine/user-level
  private feed) so `dotnet restore` here never needs auth it doesn't have, both
  locally and in CI. The private registry is used solely by the publish job to
  push the built .nupkg (it passes its own source and api-key), not for restore.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
