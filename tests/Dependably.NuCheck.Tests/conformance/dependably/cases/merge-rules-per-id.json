{
  "name": "merge-rules-per-id",
  "description": "rules merge per id: distinct ids union; a shared id is replaced wholesale by the tool section, severity and options together.",
  "tool": "$any",
  "files": {
    ".dependably": {
      "common": {
        "rules": {
          "$rule1": "error",
          "$rule2": "warn"
        }
      },
      "$tool": {
        "rules": {
          "$rule2": [
            "error",
            {}
          ]
        }
      }
    }
  },
  "expect": {
    "resolved": {
      "rules": {
        "$rule1": "error",
        "$rule2": [
          "error",
          {}
        ]
      }
    }
  }
}
