{
  "name": "sections-canonical-beats-alias",
  "description": "When both the canonical section and its alias exist, canonical wins and the alias is ignored (still warns).",
  "tool": "$any",
  "requires": [
    "alias"
  ],
  "files": {
    ".dependably": {
      "$tool": {
        "failOn": {
          "count": 2
        }
      },
      "$alias": {
        "failOn": {
          "count": 99
        }
      }
    }
  },
  "expect": {
    "warnings": [
      "DEPRECATED_ALIAS_SECTION"
    ],
    "resolved": {
      "failOn": {
        "count": 2
      }
    }
  }
}
