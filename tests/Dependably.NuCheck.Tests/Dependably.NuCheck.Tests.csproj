<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Test on every framework the tool ships (net8.0 LTS + net10.0), so the net8 build is
         actually exercised, not just compiled. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Only the .NET 10 runtime is installed in some environments; let the net8 test host roll
         forward to it so `dotnet test` runs both target frameworks without a net8 runtime. -->
    <RollForward>Major</RollForward>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- fixtures/csharp-app is a sample .NET app the Facts tests scan (and build a temp
         COPY of); its .cs/.csproj files must not become this project's own items. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);fixtures/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dependably.NuCheck\Dependably.NuCheck.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared cross-language .dependably conformance fixtures, vendored from the dependably-spec
         repository at the commit recorded in conformance/VENDOR.md. The glob copies only *.json,
         so the corpus README and VENDOR.md stay out of the test output. -->
    <None Include="conformance\**\*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="conformance" />
  </ItemGroup>

</Project>