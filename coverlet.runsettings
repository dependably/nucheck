<?xml version="1.0" encoding="utf-8"?>
<!--
  Coverage settings for `dotnet test`. Emits the OpenCover format that the .NET
  SonarScanner ingests (sonar.cs.opencover.reportsPaths), and excludes the test
  assembly itself from the numbers.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>opencover,cobertura</Format>
          <Exclude>[NuGetCheck.Tests]*</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
