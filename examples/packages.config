  <!-- Entity Framework ORM -->
  <package id="EntityFramework" version="6.1.3" targetFramework="net462" />

  <!-- Logging framework -->
  <package id="log4net" version="2.0.8" targetFramework="net462" />

  <!-- Dependency Injection -->
  <package id="Autofac" version="4.9.1" targetFramework="net462" />

  <!-- Unit Testing -->
  <package id="NUnit" version="3.10.1" targetFramework="net462" />

  <!-- Web API -->
  <package id="WebActivatorEx" version="2.2.0" targetFramework="net462" />

  <!-- Configuration -->
  <package id="Microsoft.Extensions.Configuration" version="2.0.0" targetFramework="net462" />

  <!-- Cryptography library -->
  <package id="BouncyCastle" version="1.8.3.1" targetFramework="net462" />
</packages>
