# .gitignore (.NET)

# Build output
bin/
obj/
artifacts/
*.user

# Coverage output directory + any stray Node leftovers
coverage/
node_modules/

# Test + coverage output
[Tt]est[Rr]esults/
coverage*.xml
coverage*.json
*.opencover.xml

# Packages produced by `dotnet pack`
*.nupkg
*.snupkg

# SBOM (CycloneDX) — generated in CI, published to Dependency-Track
sbom.json
sbom-prod.json

# SonarQube scanner working/cache dirs (generated in CI)
.sonarqube/
.scannerwork/
.sonar/

# Local agent tooling state (Claude Code worktrees, settings, locks)
.claude/

# Misc
*.log
.env
.DS_Store

# The csharp-app test fixture commits App's obj/project.assets.json on purpose
# (a machine-independent, deliberately UN-restored assets file whose
# packageFolders point nowhere — see tests/Dependably.NuCheck.Tests/Facts). Un-ignore
# that one obj/ dir, then re-ignore everything in it except that one file.
!tests/Dependably.NuCheck.Tests/fixtures/csharp-app/App/obj/
tests/Dependably.NuCheck.Tests/fixtures/csharp-app/App/obj/*
!tests/Dependably.NuCheck.Tests/fixtures/csharp-app/App/obj/project.assets.json
