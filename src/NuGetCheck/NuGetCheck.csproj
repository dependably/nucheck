<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NuGetCheck</RootNamespace>
    <AssemblyName>nuget-check</AssemblyName>

    <!-- Package as a .NET global tool: `dotnet tool install -g MoonlitLabs.NuGetCheck` -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nuget-check</ToolCommandName>
    <PackageId>MoonlitLabs.NuGetCheck</PackageId>
    <Version>1.0.0</Version>
    <Authors>MHiland</Authors>
    <Company>Moonlit Labs</Company>
    <Description>Audits .NET NuGet dependencies (packages.config / packages.lock.json) for known vulnerabilities via the GitHub Advisory Database, similar to npm audit.</Description>
    <PackageTags>nuget;audit;vulnerability;security;dotnet-tool</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://gitlab.northwardlabs.ca/moonlitlabs/nuget-check.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NuGet.Packaging" Version="7.6.0" />
    <PackageReference Include="NuGet.ProjectModel" Version="7.6.0" />
    <PackageReference Include="NuGet.Versioning" Version="7.6.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
