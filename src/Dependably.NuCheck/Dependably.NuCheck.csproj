<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Dependably.NuCheck</RootNamespace>
    <AssemblyName>nucheck</AssemblyName>

    <!-- Pin the dependency graph: commit packages.lock.json and let CI restore in
         locked mode so a tampered or drifted transitive dependency fails the build. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!-- Package as a .NET global tool: `dotnet tool install -g Dependably.NuCheck` -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nucheck</ToolCommandName>
    <PackageId>Dependably.NuCheck</PackageId>
    <Version>2.1.0</Version>
    <Authors>MHiland &lt;michael@dependably.ca&gt;</Authors>
    <Company>Dependably</Company>
    <Description>Audits .NET NuGet dependencies (packages.config / packages.lock.json) for known vulnerabilities via the GitHub Advisory Database, similar to npm audit.</Description>
    <PackageTags>nuget;audit;vulnerability;security;dotnet-tool</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/dependably/nucheck.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/dependably/nucheck</PackageProjectUrl>

    <!-- Ship debug symbols as a separate .snupkg instead of bundling PDBs in the tool package. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- PackAsTool copies the whole build output (PDBs included) into tools/; strip the
       PDBs from the .nupkg — they ship in the .snupkg instead. -->
  <Target Name="RemovePdbsFromToolPackage" AfterTargets="PackTool">
    <ItemGroup>
      <TfmSpecificPackageFile Remove="@(TfmSpecificPackageFile)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <!-- PackAsTool sets IncludeBuildOutput=false, which makes the pack targets skip symbol
       collection entirely and fail the .snupkg with NU5017 (empty package). Mirror the
       SDK's _WalkEachTargetPerFramework fan-out to collect each TFM's PDB at the tools/
       path, so the .snupkg layout matches the .nupkg. NuGet prepends the tools/ folder
       itself, so TargetPath is relative to it. -->
  <Target Name="_AddToolPdbsToSymbols" AfterTargets="_WalkEachTargetPerFramework">
    <MSBuild Projects="@(_ProjectsWithTFM)"
             Targets="_GetToolDebugSymbolsWithTfm"
             BuildInParallel="$(BuildInParallel)">
      <Output TaskParameter="TargetOutputs" ItemName="_TargetPathsToSymbols" />
    </MSBuild>
    <!-- PackTask only reads TargetPathsToSymbols when IncludeBuildOutput is true. Flip it
         back here — after the build-output collection targets have already been skipped —
         so the PDBs reach the .snupkg without lib/ output leaking into the tool .nupkg
         (the .nupkg side also filters on AllowedOutputExtensionsInPackageBuildOutputFolder,
         which excludes .pdb). BuildOutputTargetFolder makes NuGet place them under
         tools/{tfm}/ instead of lib/{tfm}/. -->
    <PropertyGroup>
      <IncludeBuildOutput>true</IncludeBuildOutput>
      <BuildOutputTargetFolder>tools</BuildOutputTargetFolder>
    </PropertyGroup>
  </Target>

  <Target Name="_GetToolDebugSymbolsWithTfm"
          DependsOnTargets="DebugSymbolsProjectOutputGroup"
          Returns="@(_ToolDebugSymbols)">
    <ItemGroup>
      <_ToolDebugSymbols Include="@(DebugSymbolsProjectOutputGroupOutput)">
        <TargetPath>any/%(Filename)%(Extension)</TargetPath>
        <TargetFramework>$(TargetFramework)</TargetFramework>
      </_ToolDebugSymbols>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="NuGet.Configuration" Version="7.6.0" />
    <PackageReference Include="NuGet.Packaging" Version="7.6.0" />
    <PackageReference Include="NuGet.ProjectModel" Version="7.6.0" />
    <PackageReference Include="NuGet.Versioning" Version="7.6.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
